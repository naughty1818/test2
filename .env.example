# Nijer computer e chalate chaile: cp .env.example .env
# (Render e .env lage na, Render er Environment page e ei value gulo boshabe)

PORT=3000
MAX_FILE_MB=500

# Upload korar password (jei kono ekta shokto password dao)
APP_PASSWORD=change-me

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
