# Local: cp .env.example .env, then fill required values.
# Never commit .env or paste secrets into GitHub.
PORT=3000
NODE_ENV=development
MAX_FILE_MB=500
PG_POOL_MAX=5

# Neon PostgreSQL. Use the pooled connection string for a hosted app.
# Accounts, sessions, metadata, interactions, admin records and analytics stay here.
DATABASE_URL=

# Cloudflare R2 — keep the bucket private; only video/media objects are stored here.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the callback URI configured in Google Cloud Console.
GOOGLE_REDIRECT_URI=
APP_ORIGIN=

# NogorPay hosted checkout. Keep the API key server-side only.
# Required: copy a newly generated key from NogorPay Integrations.
NOGORPAY_API_KEY=
# Optional; defaults to the primary dashboard brand 8ETVNX.
NOGORPAY_BRAND_ID=8ETVNX
NOGORPAY_API_BASE=https://api.nogorpay.com/api/v1
NOGORPAY_WEBHOOK_URL=
# Optional but recommended: stable random 32+ char key for payout destination encryption.
# If omitted, encryption derives from SESSION_SECRET; never rotate either key without a data plan.
PAYOUT_ENCRYPTION_KEY=

# Bootstrap Owner. Must exactly match the email of the Google account used to sign in.
# This is an email address, not a secret; do not hard-code it in client code.
OWNER_EMAIL=

# Generate a random secret with: openssl rand -hex 32
SESSION_SECRET=

# Optional: set false to skip one-time legacy R2 JSON import during startup.
MIGRATE_R2_JSON_ON_START=true
