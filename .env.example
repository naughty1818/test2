# Local: cp .env.example .env, then provide the required values.
# Never commit .env or paste secret values into GitHub.
PORT=3000
NODE_ENV=development
MAX_FILE_MB=500

# Cloudflare R2 (keep the bucket private)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the callback URI configured in Google Cloud Console.
GOOGLE_REDIRECT_URI=
APP_ORIGIN=

# Generate a random secret with: openssl rand -hex 32
SESSION_SECRET=
